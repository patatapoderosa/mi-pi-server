{
  "name": "pi-remote-system",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted 24/7 Pi Coding Agent node on an old PC, remote-controlled from Mac and phone over Telegram. No VPS, no port forwarding.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "test:windows": "pwsh -NoProfile -NonInteractive -File installer/tests/Invoke-SmokeTests.ps1",
    "release:windows": "pwsh -NoProfile -NonInteractive -File installer/New-Release.ps1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.7",
    "typescript": "^5.6.0"
  }
}
