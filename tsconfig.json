{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "shared/**/*.ts",
    "server/pi-remote-config/**/*.ts",
    "mac/pi-remote/**/*.ts",
    "tests/**/*.ts",
    "server/pi-remote-server/**/*.ts"
  ]
}
